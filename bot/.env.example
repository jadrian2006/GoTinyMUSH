# GoTinyMUSH Bot Configuration
# Copy to .env and fill in values

# --- MUSH Connection ---
MUSH_WS_URL=ws://localhost:8443/ws
MUSH_REST_URL=http://localhost:8443

# Auth mode: "password" or "apikey"
AUTH_MODE=password

# Password auth (AUTH_MODE=password)
MUSH_USER=BotName
MUSH_PASS=botpassword

# API key auth (AUTH_MODE=apikey)
# MUSH_DBREF=#123
# MUSH_APIKEY=64-char-hex-key

# --- LLM Provider ---
# Provider: "anthropic" or "openai"
LLM_PROVIDER=anthropic
LLM_API_KEY=sk-ant-...
LLM_MODEL=claude-sonnet-4-20250514

# Custom base URL for OpenAI-compatible APIs (Ollama, vLLM, etc.)
# LLM_BASE_URL=http://localhost:11434/v1

# Max response tokens
LLM_MAX_TOKENS=300

# --- Bot Behavior ---
BOT_NAME=Assistant

# System prompt (personality). Leave empty for default.
# BOT_SYSTEM_PROMPT=You are a wise old wizard in a fantasy realm...

# Comma-separated trigger patterns (regex). Bot always responds to its name.
# BOT_TRIGGERS=oracle,tell me

# Respond to ALL room speech (not just mentions)
BOT_TRIGGER_ALL_ROOM=false

# Channel config: JSON array of {name, alias, triggerAll?}
# BOT_CHANNELS=[{"name":"Public","alias":"pub"},{"name":"OOC","alias":"ooc","triggerAll":true}]

# --- Tuning ---
CONTEXT_MAX_MESSAGES=20
CONTEXT_TTL_MINUTES=30
COOLDOWN_MS=2000
MAX_RESPONSE_LENGTH=900
